<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>ZG2</AssemblyName>
    <RootNamespace>ZG2</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Exclude the References folder (decompiled game source, not part of mod) -->
  <ItemGroup>
    <Compile Remove="References\**" />
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.*" />
    <PackageReference Include="Krafs.Publicizer" Version="2.*" />
    <PackageReference Include="DVMultiplayerAPI" Version="1.1.0" />
  </ItemGroup>

  <!-- Publicize Assembly-CSharp to access private/internal members at compile time -->
  <ItemGroup>
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>

  <!-- Game DLL references (paths resolved via Directory.Build.targets ReferencePath) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp" />
    <Reference Include="DV.Utils" />
    <Reference Include="DV.Common" />
    <Reference Include="DV.CabControls.Spec" />
    <Reference Include="DV.Inventory" />
    <Reference Include="DV.Localization" />
    <Reference Include="DV.ThingTypes" />
    <Reference Include="DV.UIFramework" />
    <Reference Include="DV.Simulation" />
    <Reference Include="Newtonsoft.Json" />

    <!-- Unity engine modules -->
    <Reference Include="UnityEngine.CoreModule" />
    <Reference Include="UnityEngine.PhysicsModule" />
    <Reference Include="UnityEngine.AssetBundleModule" />
    <Reference Include="UnityEngine.IMGUIModule" />

    <!-- Unity Mod Manager -->
    <Reference Include="UnityModManager" />

    <!-- WorldStreamer (contains WorldMover) -->
    <Reference Include="WorldStreamer" />

    <!-- DV.UI (contains CanvasController, ACanvasController) -->
    <Reference Include="DV.UI" />

    <!-- custom_item_mod framework (UMM mod dependency) -->
    <Reference Include="custom_item_mod" />
    <Reference Include="custom_item_components" />

    <!-- TMPro and DV.Shops (needed by custom_item_mod API types) -->
    <Reference Include="Unity.TextMeshPro" />
    <Reference Include="DV.Layers" />
  </ItemGroup>

</Project>
